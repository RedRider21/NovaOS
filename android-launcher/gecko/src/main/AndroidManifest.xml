<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Senza la dichiarazione, requestPermissions non mostra alcun dialogo e
         risponde «negato» all'istante: il comando requestMic sembrerebbe rotto
         mentre invece è il modulo a essere incompleto. Nel modulo :app il
         permesso c'è già (RECORD_AUDIO, richiesto dal registratore). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Stessa ragione, per la fotocamera: senza la dichiarazione il
         PermissionDelegate non può chiedere il permesso, la richiesta di
         getUserMedia({video:true}) viene rifiutata e l'app Fotocamera mostra
         l'anteprima nera — senza un errore che spieghi perché. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Telefonia. Come sopra, la dichiarazione non è una formalità: senza, il
         permesso non è nemmeno chiedibile e `call` resterebbe per sempre sul
         ramo ACTION_DIAL, cioè «sembra che chiami» invece di chiamare. Sono
         permessi pericolosi e si concedono a runtime (o con pm grant). -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- VIBRATE non è fra i permessi che si concedono a runtime (è «normale»), e
         per questo è facile dimenticarlo: senza la riga, `vibrate` non fallisce in
         silenzio — solleva SecurityException sul thread principale e PORTA GIÙ IL
         PROCESSO. Scoperto così: la shell vibra prima di ogni chiamata
         (apps.js:55), quindi il primo tentativo di chiamata uccideva la shell
         invece di chiamare. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Stato reale di connettività, letto da sensorStates. Sono permessi
         «normali» (nessun dialogo), ma vanno dichiarati lo stesso: senza,
         WifiManager.isWifiEnabled e NfcAdapter.isEnabled sollevano
         SecurityException, i lettori la assorbono e rispondono «spento» — cioè
         un interruttore che mente invece di un dato che manca. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- BLUETOOTH_CONNECT è l'unico di questi che si concede a RUNTIME (Android
         12+): finché non è concesso, isEnabled() solleva SecurityException. È il
         motivo per cui lo stato del Bluetooth è l'unico che nasce «non noto»
         invece che «spento» — vedi MainActivity.statoSensori. -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.NFC" />

    <!-- Permessi PRIVILEGIATI: un'app normale non li ottiene e qui non hanno
         effetto; nel ROM definitivo, con NovaOS come priv-app firmata + whitelist,
         vengono concessi e i set* commutano direttamente invece di aprire il
         pannello di sistema. Dichiararli ora è ciò che rende lo stesso codice
         valido su entrambe le tracce. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.MODIFY_PHONE_STATE" />
    <uses-permission android:name="android.permission.NETWORK_SETTINGS" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <!-- Necessario su Android 11+ per aprire il dialer e l'app SMS di sistema:
         senza, startActivity fallisce con ActivityNotFoundException. -->
    <queries>
        <intent><action android:name="android.intent.action.DIAL" /></intent>
        <intent><action android:name="android.intent.action.CALL" /></intent>
        <intent><action android:name="android.intent.action.SENDTO" /><data android:scheme="smsto" /></intent>
    </queries>

    <application
        android:label="NovaOS Gecko (spike)"
        android:hardwareAccelerated="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- I quattro filtri che rendono NovaOS candidabile a telefono predefinito
                 (ROLE_DIALER), copiati da :app. Non sono decorazione: il
                 RoleController pretende DUE filtri DIAL — uno senza scheme e uno con
                 scheme tel — e senza entrambi segnala "missing RequiredComponent" e
                 il ruolo non è assegnabile. È il prerequisito di NovaInCallService:
                 senza il ruolo quel servizio non viene mai legato. -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.CALL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!-- Servizio di chiamata: attivo solo quando NovaOS è il telefono predefinito.
             Mostra la schermata di chiamata dentro NovaOS invece di quella di sistema.
             La permission non è una richiesta ma un vincolo: solo il sistema può
             legarlo, ed è ciò che impedisce a un'app qualsiasi di fingersi noi. -->
        <service
            android:name=".NovaInCallService"
            android:permission="android.permission.BIND_INCALL_SERVICE"
            android:exported="true">
            <meta-data android:name="android.telecom.IN_CALL_SERVICE_UI" android:value="true"/>
            <intent-filter>
                <action android:name="android.telecom.InCallService"/>
            </intent-filter>
        </service>

        <!-- Il browser clone-Chrome. Nel modulo :app è la destinazione di
             openBrowser; qui è la COPIA dello stesso file, per verificare che il
             dock apra davvero il browser nativo invece dell'anteprima in-app
             della shell. Resta basato su WebView: portarlo a GeckoView è un
             passo a sé, e questo spike serve a provare il ponte, non il browser. -->
        <activity
            android:name=".BrowserActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@android:style/Theme.NoTitleBar" />

        <!-- Condivisione verso le altre app (shareImage/shareFile). L'autorità deve
             corrispondere carattere per carattere a ShareProvider.AUTHORITY: è il
             nome con cui il sistema risolve content://os.nova.gecko.share/…, e se
             diverge il provider non viene mai interpellato.
             exported="false" perché non ha nulla da offrire al resto del sistema:
             ci si arriva solo con un URI che abbiamo coniato noi, e
             grantUriPermissions="true" è ciò che rende quel permesso trasferibile
             all'app scelta nel chooser — senza, il file resterebbe nostro e
             l'app che lo riceve non riuscirebbe ad aprirlo. -->
        <provider
            android:name=".ShareProvider"
            android:authorities="os.nova.gecko.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
